+//! A [`VortexReadAt`] backed by caller-supplied C callbacks.
+//!
+//! Vortex normally does its own I/O, which means an embedding host has to hand
+//! Vortex a path plus enough configuration to reach the storage itself. That is
+//! a poor fit for hosts that already have a configured I/O stack -- credentials,
+//! endpoints, retry policy, request signing -- because it forces that
+//! configuration to be duplicated, and duplicated differently, on the Vortex
+//! side. Letting the host supply the bytes instead keeps one I/O path.
+//!
+//! The Java bindings already work this way via `dev.vortex.io.NativeReadable`;
+//! this is the same arrangement expressed as C function pointers. See
+//! <https://github.com/vortex-data/vortex/issues/8433>.
+
+use std::ffi::c_void;
+use std::sync::Arc;
+
+use futures::FutureExt;
+use futures::future::BoxFuture;
+use vortex::array::buffer::BufferHandle;
+use vortex::buffer::Alignment;
+use vortex::buffer::ByteBufferMut;
+use vortex::error::VortexResult;
+use vortex::error::vortex_bail;
+use vortex::error::vortex_ensure;
+use vortex::error::vortex_err;
+use vortex::io::CoalesceConfig;
+use vortex::io::VortexReadAt;
+use vortex::io::runtime::BlockingRuntime;
+use vortex::io::runtime::Handle;
+
+use crate::string::vx_view;
+
+/// Default cap on concurrent read callbacks when a caller passes 0.
+///
+/// Matches the object-store default: a host that delegates its I/O is usually
+/// talking to remote storage, where deep queues matter more than they cost.
+const DEFAULT_CONCURRENCY: usize = 192;
+
+/// A random-access byte source implemented by the caller.
+///
+/// Vortex invokes "read_at" from its own worker threads, potentially many calls
+/// at once, so the implementation must tolerate concurrent positional reads.
+/// The struct itself is only read during the call that consumes it; the
+/// callbacks and "ctx" must stay valid until "release" runs.
+#[repr(C)]
+pub struct vx_readat {
+    /// Opaque caller state passed to every callback. May be NULL.
+    pub ctx: *mut c_void,
+    /// Total length of the source in bytes. Required: Vortex reads the footer
+    /// relative to the end, so a wrong length surfaces as a corrupt file.
+    pub len: u64,
+    /// Maximum number of concurrent "read_at" calls. 0 selects a default.
+    pub concurrency: usize,
+    /// Optional name, typically the original URI. Used for cache keys and error
+    /// messages, so it should be stable and unique. Bytes are copied. Pass a
+    /// zero-length view for an anonymous source.
+    pub name: vx_view,
+    /// Read exactly "length" bytes starting at absolute "offset" into "dst".
+    ///
+    /// Short reads are not permitted: either fill the whole buffer and return 0,
+    /// or return non-zero to fail the read. Returning 0 without filling the
+    /// buffer hands uninitialized memory to the scan.
+    ///
+    /// Required.
+    pub read_at: Option<
+        unsafe extern "C" fn(ctx: *mut c_void, offset: u64, dst: *mut u8, length: usize) -> i32,
+    >,
+    /// Called once, when Vortex has finished with the source. Optional.
+    pub release: Option<unsafe extern "C" fn(ctx: *mut c_void)>,
+}
+
+/// The callbacks and context, owned for as long as Vortex holds the source.
+struct CReadAtInner {
+    ctx: *mut c_void,
+    len: u64,
+    concurrency: usize,
+    name: Option<Arc<str>>,
+    read_at: unsafe extern "C" fn(*mut c_void, u64, *mut u8, usize) -> i32,
+    release: Option<unsafe extern "C" fn(*mut c_void)>,
+}
+
+// SAFETY: the documented contract for `vx_readat` requires `read_at` to be safe
+// to call concurrently from arbitrary threads, and `ctx` to be valid until
+// `release`. Vortex holds the source behind an Arc and calls nothing after drop.
+unsafe impl Send for CReadAtInner {}
+unsafe impl Sync for CReadAtInner {}
+
+impl Drop for CReadAtInner {
+    fn drop(&mut self) {
+        if let Some(release) = self.release {
+            // SAFETY: called exactly once, on the last owner, and after every
+            // read has completed - reads borrow the Arc that owns this.
+            unsafe { release(self.ctx) };
+        }
+    }
+}
+
+/// A [`VortexReadAt`] that forwards positional reads to C callbacks.
+///
+/// The callback is blocking, so each read runs on the runtime's blocking pool
+/// rather than on the thread driving the scan: the FFI runtime is
+/// current-thread, and calling out to host I/O directly from a future would
+/// stall every other task on it.
+struct CReadAt {
+    inner: Arc<CReadAtInner>,
+    handle: Handle,
+}
+
+impl VortexReadAt for CReadAt {
+    fn uri(&self) -> Option<&Arc<str>> {
+        self.inner.name.as_ref()
+    }
+
+    fn coalesce_config(&self) -> Option<CoalesceConfig> {
+        // Each read crosses the FFI boundary into host I/O that is usually
+        // remote, so prefer fewer, larger requests.
+        Some(CoalesceConfig::object_storage())
+    }
+
+    fn concurrency(&self) -> usize {
+        self.inner.concurrency
+    }
+
+    fn size(&self) -> BoxFuture<'static, VortexResult<u64>> {
+        let len = self.inner.len;
+
+        async move { Ok(len) }.boxed()
+    }
+
+    fn read_at(
+        &self,
+        offset: u64,
+        length: usize,
+        alignment: Alignment,
+    ) -> BoxFuture<'static, VortexResult<BufferHandle>> {
+        let inner = Arc::clone(&self.inner);
+        let handle = self.handle.clone();
+
+        async move {
+            handle
+                .spawn_blocking(move || {
+                    let end = offset
+                        .checked_add(length as u64)
+                        .ok_or_else(|| vortex_err!("read {offset}+{length} overflows u64"))?;
+                    if end > inner.len {
+                        vortex_bail!(
+                            "read {offset}..{end} out of bounds for source of length {}",
+                            inner.len
+                        );
+                    }
+
+                    let mut buffer = ByteBufferMut::with_capacity_aligned(length, alignment);
+
+                    if length > 0 {
+                        // SAFETY: the spare capacity covers `length` bytes of live
+                        // allocation, and the pointer is not retained past the call.
+                        let rc = unsafe {
+                            (inner.read_at)(
+                                inner.ctx,
+                                offset,
+                                buffer.spare_capacity_mut().as_mut_ptr().cast(),
+                                length,
+                            )
+                        };
+                        if rc != 0 {
+                            vortex_bail!(
+                                "read_at callback failed with code {rc} for {offset}..{end}"
+                            );
+                        }
+                    }
+
+                    // SAFETY: the callback contract requires all `length` bytes to be
+                    // written whenever it reports success.
+                    unsafe { buffer.set_len(length) };
+
+                    Ok(BufferHandle::new_host(buffer.freeze()))
+                })
+                .await
+        }
+        .boxed()
+    }
+}
+
+/// Build an owned [`VortexReadAt`] from a caller-supplied `vx_readat`.
+///
+/// On failure the caller keeps ownership of `ctx`: `release` is only wired up
+/// once the source has been constructed, so a rejected descriptor never
+/// double-frees.
+pub(crate) unsafe fn read_at_from_ffi(reader: *const vx_readat) -> VortexResult<Arc<dyn VortexReadAt>> {
+    vortex_ensure!(!reader.is_null(), "null vx_readat");
+
+    let reader = unsafe { &*reader };
+    let read_at = reader
+        .read_at
+        .ok_or_else(|| vortex_err!("vx_readat.read_at is required"))?;
+
+    let name = if reader.name.ptr.is_null() || reader.name.len == 0 {
+        None
+    } else {
+        Some(Arc::from(unsafe { reader.name.as_str() }?))
+    };
+
+    let concurrency = if reader.concurrency == 0 {
+        DEFAULT_CONCURRENCY
+    } else {
+        reader.concurrency
+    };
+
+    Ok(Arc::new(CReadAt {
+        inner: Arc::new(CReadAtInner {
+            ctx: reader.ctx,
+            len: reader.len,
+            concurrency,
+            name,
+            read_at,
+            release: reader.release,
+        }),
+        handle: crate::RUNTIME.handle(),
+    }))
+}
